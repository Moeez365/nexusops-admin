# ==============================================================================
# Comprehensive Project .gitignore (Root, Frontend, & Backend)
# ==============================================================================

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
*/node_modules/
.pnp/
.pnp.js

# ── Environment Variables & Secrets ──────────────────────────────────────────
.env
.env.*
!.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# ── Build & Distribution Artifacts ───────────────────────────────────────────
dist/
dist-ssr/
build/
out/
frontend/dist/
frontend/dist-ssr/
*.tsbuildinfo

# ── Logs & Debugging ─────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Uploads & Generated Media ────────────────────────────────────────────────
backend/images/*
!backend/images/.gitkeep
uploads/
tmp/
temp/

# ── Runtime & Cache ──────────────────────────────────────────────────────────
.cache/
.parcel-cache/
.eslintcache/
.stylelintcache/
.vite/
.turbo/
.next/

# ── Testing & Coverage ───────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ── Operating System & File System ───────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ── IDEs, Editors & Tooling ──────────────────────────────────────────────────
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ── Local Agent Workspaces & Temporary AI Caches ─────────────────────────────
.agents/*
!.agents/skills/
!.agents/rules/
.gemini/

